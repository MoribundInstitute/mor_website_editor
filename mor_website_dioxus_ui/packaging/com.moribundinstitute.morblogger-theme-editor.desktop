# DEPRECATED: renamed from Blogger branding to website branding.
# Use: com.moribundinstitute.morwebsite-theme-editor.desktop
# (or com.moribundinstitute.morwebsite-editor.desktop — unified StartupWMClass/prgname).
# This file is kept only as a pointer so old packaging docs do not 404.

[Desktop Entry]
Type=Application
Name=MorWebsite Theme Editor
Comment=DEPRECATED entry — use com.moribundinstitute.morwebsite-theme-editor.desktop. Visual design-token theme editor for local websites (not Blogger)
Exec=/home/deo-user/ai_workspace/website-tools/mor_website_editor/target/debug/mor_website_dioxus_ui
Icon=com.moribundinstitute.morwebsite-theme-editor
Terminal=false
Categories=Development;WebDevelopment;
StartupWMClass=com.moribundinstitute.morwebsite-editor
NoDisplay=true
